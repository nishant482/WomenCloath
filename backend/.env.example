MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rajo_threads
APP_URL=http://localhost:5173
# Explicit additional storefront origins, comma-separated (no wildcards).
ADDITIONAL_ALLOWED_ORIGINS=
API_PORT=3001
EMAIL_USER=
EMAIL_PASS=
# Separate new-product email sender. Keep paused until a Gmail App Password is set.
PRODUCT_EMAIL_USER=info.rajothreads@gmail.com
PRODUCT_EMAIL_PASS=
EMAIL_QUEUE_SECRET=
STORE_PUBLIC_URL=https://rajothreads.com
ADMIN_EMAIL=
REQUIRE_EMAIL_VERIFICATION=false
# Optional public Vercel Blob store token. Image URLs work without it.
BLOB_READ_WRITE_TOKEN=
# Optional Cloudflare Images storage; takes priority over Vercel Blob.
# Server-only token with Account > Cloudflare Images > Edit permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
# Cloudinary free plan image storage; preferred when configured. Server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Preferred: Cloudflare R2 Standard storage. Server-only bucket credentials.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public delivery base URL, NOT the private S3 API endpoint.
R2_PUBLIC_URL=
# Alternative: private R2 bucket through the deployed image Worker.
R2_GATEWAY_URL=
R2_GATEWAY_TOKEN=
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
